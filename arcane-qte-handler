----------------------------------------------------- Block QTE

local BlockExpanded = false

local function DoBlockBar(Indicator, Target)
    -- Expand the Block zone to cover the entire Inset width.
    -- GuiCollisionService.isColliding (used by the game's validation) reads
    -- AbsolutePosition + AbsoluteSize, so making the zone span the whole bar
    -- means any space press during the QTE collides with the zone.
    if not BlockExpanded then
        memory.writef32(Target, AbsolutePositionOffset, 0)      -- AbsolutePosition.X = 0
        memory.writef32(Target, AbsoluteSizeOffset, 10000)      -- AbsoluteSize.X = 10000
        BlockExpanded = true
    end

    -- The original "new run detection" still works since the indicator's tween
    -- is unchanged.
    local IndicatorPositionX = memory.readf32(Indicator, Offsets.FramePositionX)
    if IndicatorPositionX < 0.1 then
        return
    end

    local Cooldown = os.clock() < QTE_UI.BlockingQTE.Debounce

    if not Cooldown then
        QTE_UI.BlockingQTE.Debounce = os.clock() + 1
        print("[Block] auto-pressed")
        PressKey(32)
        QTE_UI.BlockingQTE.LastVisibleTime = nil
    end
end

----------------------------------------------------- Magic QTE

local function GetRunePairs(Slots, Pieces)
    local SlotLookup = {}
    local FinalPairs = {}
    local NumberToProcess = 0

    if #Pieces == 0 then return NumberToProcess, {} end

    for _, slot in Slots do
        local sName = GetName(slot)
        if sName and sName ~= "UIGridLayout" then
            SlotLookup[sName] = slot
        end
    end

    for _, piece in Pieces do
        local pName = GetName(piece)
        if pName ~= "Slotted" then
            NumberToProcess += 1
            local matchedSlot = SlotLookup[pName]
            if matchedSlot then
                FinalPairs[piece] = matchedSlot
            end
        end
    end

    return NumberToProcess, FinalPairs
end

local MagicThread = false

local function DoMagicQTE(SlotsFolder, PiecesFolder)
    local NumberToProcess, RunePairs = GetRunePairs(
        SlotsFolder:GetChildren(),
        PiecesFolder:GetChildren()
    )

    for piece, slot in pairs(RunePairs) do
        if not MagicThread then
            MagicThread = true
            local CenterPiecePosition = GetCenter(piece)
            local CenterSlotPosition = GetCenter(slot)
            ClickAndDragTo(CenterPiecePosition, CenterSlotPosition, 0.03, 5)
            MagicThread = false
            break
        end
    end
end

