--[[
    Arcane Lineage QTE auto-handler - Severe port
    Converted from Matcha. Key changes:
      - memory_read("type", addr)              -> memory.read<type>(userdata, offset)
      - Instance.Address                       -> pass the userdata + offset directly to memory.*
      - HttpService:JSONDecode                 -> crypt.json.decode
      - notify(msg, title, dur)                -> send_notification(content)
      - ismouse1pressed                        -> isleftpressed
      - Player:GetMouse                        -> use UserInputService:GetMouseLocation
      - RunService.Heartbeat (not in Severe)   -> task.spawn loop with task.wait()
      - Signal :Connect/:Disconnect            -> :connect/:disconnect (lowercase)
      - mouse1press/release/move helpers exist on Severe with the same names
      - keypress/keyrelease exist on Severe with the same names

    Memory offsets (ScreenGuiEnabled, FrameVisible, FramePositionX, FrameRotation,
    Name pointer, Image, BackgroundColor3) come from the same offsets feeds the
    original used; on Severe we just pass them as the `offset` argument to the
    typed memory readers instead of building absolute addresses by hand.
--]]

----------------------------------------------------- Offsets
local AutoSkillEnabled = true  -- toggle to false to disable auto-skill
local InCombat = false
local Offsets = crypt.json.decode(game:HttpGet("https://offsets.ntgetwritewatch.workers.dev/offsets.json"))
-- Pinned to the version dump that matches your Roblox build. The generic
-- /Offsets/Offsets.json URL is a fallback in case the pinned URL goes stale.
local TheoOffsets do
    local function fetch(url)
        local ok, body = pcall(game.HttpGet, game, url)
        if not ok or not body then return nil end
        local okDecode, decoded = pcall(crypt.json.decode, body)
        if not okDecode or type(decoded) ~= "table" or not decoded.Offsets then return nil end
        return decoded.Offsets, decoded["Roblox Version"]
    end

    local urls = {
        "https://imtheo.lol/Offsets/version-9d412f44a6fe4081/Offsets.json",
        "https://imtheo.lol/Offsets/Offsets.json",
    }

    for _, url in ipairs(urls) do
        local offsets, version = fetch(url)
        if offsets then
            TheoOffsets = offsets
            print(string.format("[Offsets] Loaded %s (Roblox %s)", url, tostring(version)))
            break
        else
            warn("[Offsets] Failed to load " .. url)
        end
    end

    if not TheoOffsets then
        error("Could not load Theo offsets from any URL")
    end
end

