local InputTableForWASD = {
    { ["Rot"] = "rbxassetid://118628353797999", ["PressKeycode"] = 87 }, -- up    W
    { ["Rot"] = "rbxassetid://140027853530361", ["PressKeycode"] = 68 }, -- right D
    { ["Rot"] = "rbxassetid://126374325851918", ["PressKeycode"] = 83 }, -- down  S
    { ["Rot"] = "rbxassetid://93065360272027",  ["PressKeycode"] = 65 }, -- left  A
}

local IDLE_COLOR = Color3.new(1, 1, 1)
-- Keyed by the userdata itself rather than the address number.
local PressedIndices = {}

local function DoFistQTE(KeyHolder)
    local KeysToProcess = {}

    for _, Key in KeyHolder:GetChildren() do
        if Key.Name ~= "UIListLayout" then
            table.insert(KeysToProcess, Key)
        end
    end

    table.sort(KeysToProcess, function(a, b)
        return tonumber(a.Name) < tonumber(b.Name)
    end)

    for i, v in KeysToProcess do
        if PressedIndices[v] then continue end

        local ImgColor = GetImageColor(v)

        if ImgColor then
            print(string.format("Checking %s | BG: %.4f, %.4f, %.4f",
                v.Name, ImgColor.R, ImgColor.G, ImgColor.B))
        end

        if not ColorsMatch(ImgColor, IDLE_COLOR) then
            local currentId = GetImageId(v)
            for _, data in InputTableForWASD do
                if data.Rot == currentId then
                    PressedIndices[v] = true
                    PressKey(data.PressKeycode)
                    return
                end
            end
        end
    end
end

----------------------------------------------------- Dagger QTE

local LockedRings = {}

local function DoDaggerQTE(RingsFolder)
    task.wait(0.1)
    while true do
        local children = RingsFolder:GetChildren()
        local RingsExist = false

        for _, Ring in ipairs(children) do
            local idx = tonumber(Ring.Name)
            if idx then
                RingsExist = true
                if not LockedRings[Ring] then
                    LockedRings[Ring] = true
                    LockRotationForDuration(Ring, 0, 3)
                    print("Locked ", idx)
                end
                SAFEWriteFrameRotation(Ring, 0)
            end
        end

        if not RingsExist then
            print("No visible rings remaining. Exiting.")
            LockedRings = {}
            break
        end

        keypress(32)
        keyrelease(32)
        task.wait(0.05)
    end
end

----------------------------------------------------- Sword QTE

local SwordExpanded = false
local PressedSwordZones = {}
local SwordLockThread = nil

local function DoSwordQTE(Inset, Window)
    if not SwordLockThread then
        SwordLockThread = task.spawn(function()
            -- Expand Window to cover the whole Inset width on QTE start
            if not SwordExpanded then
                memory.writef32(Window, AbsolutePositionOffset, 0)
                memory.writef32(Window, AbsoluteSizeOffset, 10000)
                SwordExpanded = true
            end

            while IsFrameVisible(QTE_UI.SwordQTE.QTE_Container) do
                -- Find the lowest-numbered unpressed zone
                local lowestUnpressed = nil
                local lowestN = math.huge
                for _, child in Inset:GetChildren() do
                    local n = tonumber(child.Name)
                    if n and not PressedSwordZones[child] then
                        if n < lowestN then
                            lowestN = n
                            lowestUnpressed = child
                        end
                    end
                end

                -- Press space for each zone as it becomes the active one
                if lowestUnpressed and os.clock() >= QTE_UI.SwordQTE.Debounce then
                    PressedSwordZones[lowestUnpressed] = true
                    QTE_UI.SwordQTE.Debounce = os.clock() + 0.05
                    PressKey(32)
                    print(string.format("[Sword] PRESSED zone %d", lowestN))
                end

                task.wait()
            end
            SwordLockThread = nil
        end)
    end
end

----------------------------------------------------- Spear QTE

local function DoSpearQTE(RingsFolder)
    local Ring = RingsFolder:FindFirstChild("Ring")
    if not Ring then return end

    local Indicator = Ring:FindFirstChild("Indicator")
    if not Indicator then return end

    local Transparency = GetImageTransparency(Indicator)
    local IndicatorSize = GetAbsoluteSize(Indicator)

    -- Bail if the ring hasn't laid out yet (size hasn't been computed)
    if IndicatorSize.X <= 1 then return end

    local IsReady = (Transparency and Transparency > 0.75)
                and (IndicatorSize.X < 135)

    if not IsReady then return end

    local RingPos = GetCenter(Ring)
    mousemoveabs(RingPos.X, RingPos.Y)
    mousemoverel(1, 1)
    mouse1press()
    mouse1release()
end
----------------------------------------------------- Combat thread

local QTE_Locks = {}

local function CombatLoop()
    while true do
        local ok, err = pcall(function()
            for QTE_Type, Data in pairs(QTE_UI) do
                if not Data.QTE_Container then continue end

                local QTE_Visible = IsFrameVisible(Data.QTE_Container)

                if QTE_Visible then
                    Data.IsActive = true

                    if not QTE_Locks[QTE_Type] then
                        task.spawn(function()
                            QTE_Locks[QTE_Type] = true

                            local handlerOk, handlerErr = pcall(function()
                                if QTE_Type == "FistQTE" then
                                    task.wait(0.2)
                                    DoFistQTE(Data.KeyHolder)
                                elseif QTE_Type == "BlockingQTE" then
                                    DoBlockBar(Data.Indicator, Data.Target)
                                elseif QTE_Type == "MagicQTE" then
                                    DoMagicQTE(Data.RuneSlots, Data.RunePieces)
                                elseif QTE_Type == "DaggerQTE" then
                                    DoDaggerQTE(Data.QTE_Container)
                                elseif QTE_Type == "SwordQTE" then
                                    DoSwordQTE(Data.Inset, Data.Window)
                                elseif QTE_Type == "SpearQTE" then
                                    DoSpearQTE(Data.QTE_Container)
                                    task.wait(0.1)
                                end
                            end)
                            if not handlerOk then
                                warn("[QTE] " .. QTE_Type .. " handler error: " .. tostring(handlerErr))
                            end

                            QTE_Locks[QTE_Type] = false
                        end)
                    end
                else
                    if Data.IsActive then
                        QTE_Locks[QTE_Type] = false
                        Data.LastVisibleTime = nil
                        Data.IsActive = false
                        PressedIndices = {}
                        PressedSwordZones = {}
                        BlockExpanded = false
                        SwordExpanded = false
                    end
                end
            end
        end)

        if not ok then
            warn("[CombatLoop] iteration error: " .. tostring(err))
        end

        task.wait()
    end
end


----------------------------------------------------- AutoSkill helpers

-- Wait until a GUI's AbsolutePosition has been stable for ~50ms.
local function waitForStable(gui, timeout)
    timeout = timeout or 1.0
    local start = os.clock()
    local lastX, lastY = -1, -1
    local stableSince = nil
    while os.clock() - start < timeout do
        local x = memory.readf32(gui, AbsolutePositionOffset)
        local y = memory.readf32(gui, AbsolutePositionOffset + 4)
        if math.abs(x - lastX) < 0.5 and math.abs(y - lastY) < 0.5 then
            if not stableSince then stableSince = os.clock() end
            if os.clock() - stableSince >= 0.05 then return true end
        else
            stableSince = nil
        end
        lastX, lastY = x, y
        task.wait()
    end
    return false
end

local function ClickGui(gui, label)
    waitForStable(gui, 1.0)
    local c = GetCenter(gui)
    if c.X <= 0 or c.Y <= 0 then return false end

    -- Teleport to slightly below center (more reliable hover region)
    local clickX = c.X
    local clickY = c.Y + 5

    print(string.format("[AutoSkill] Clicking %s at (%.0f, %.0f)", label, clickX, clickY))

    -- Jitter sequence: teleport to a few nearby points around the target.
    -- This forces MouseMoved events to fire so the GUI registers a hover.
    -- A single mousemoveabs sometimes doesn't trigger MouseEnter on the
    -- destination element.
    mousemoveabs(clickX - 3, clickY - 3)
    task.wait(0.02)
    mousemoveabs(clickX + 3, clickY + 3)
    task.wait(0.02)
    mousemoveabs(clickX, clickY)
    task.wait(0.05)

    -- Tiny relative nudge to be extra sure MouseMoved fires at the click site
    mousemoverel(1, 0)
    task.wait(0.01)
    mousemoverel(-1, 0)
    task.wait(0.02)

    mouse1press()
    task.wait(0.08)
    mouse1release()
    return true
end

local function WaitFor(cond, timeout, label)
    local start = os.clock()
    while os.clock() - start < timeout do
        if cond() then return true end
        task.wait()
    end
    print(string.format("[AutoSkill] Timeout: %s", label or "?"))
    return false
end

----------------------------------------------------- Skill priority
-- Priority list, top-to-bottom. First usable skill wins.
-- Anything not listed here falls back to alphabetic order at the end.

local SkillPriority = _G.SkillPriority or {
    -- Buffs / heals first
   -- "Lesser Empower",

    -- Heavy damage skills next
    --"Pommel Strike",
   -- "Double Slash",
    -- Default attack last
    "Strike",
}

local function FindUsableSkill(combat)
    local Scroll = combat.ActionBG.AttacksPage.Attack.ScrollingFrame

    local function isUsable(skill)
        if not skill or not skill:IsA("GuiObject") then return false end
        if skill.Name == "UIListLayout" then return false end
        local cd = skill:FindFirstChild("CD")
        return cd and not IsFrameVisible(cd)
    end

    -- Priority list first
    for _, name in ipairs(SkillPriority) do
        local skill = Scroll:FindFirstChild(name)
        if isUsable(skill) then return skill end
    end

    -- Fallback: any usable skill
    for _, skill in Scroll:GetChildren() do
        if isUsable(skill) then return skill end
    end
    return nil
end

local function FindFirstEnemy(combat)
    local Scroll = combat.ActionBG.AttacksPage.Enemies.ScrollingFrame
    for _, enemy in Scroll:GetChildren() do
        if enemy:IsA("GuiObject")
           and enemy.Name ~= "UIListLayout"
           and enemy.Name ~= "EnemyTemplate"
        then
            return enemy
        end
    end
    return nil
end

local function AutoSkill(combat)
    local ActionBG     = combat:FindFirstChild("ActionBG")
    if not ActionBG then return end
    local ContextPage  = ActionBG:FindFirstChild("ContextPage")
    local AttacksPage  = ActionBG:FindFirstChild("AttacksPage")
    if not ContextPage or not AttacksPage then return end
    local AttackButton = ContextPage:FindFirstChild("AttackButton")
    local AttackScroll = AttacksPage.Attack and AttacksPage.Attack:FindFirstChild("ScrollingFrame")
    if not AttackButton or not AttackScroll then return end

    -- Step 1: open Attack page
    for attempt = 1, 3 do
        if not IsFrameVisible(ContextPage) then return end
        ClickGui(AttackButton, "AttackButton #" .. attempt)
        if WaitFor(function() return IsFrameVisible(AttackScroll) end, 1.5,
                   "Attack scroll opens") then break end
        if attempt == 3 then return end
    end

    task.wait(0.15)

    -- Step 2: pick and click a skill
    local chosen = FindUsableSkill(combat)
    if not chosen then return end
    print("[AutoSkill] Selected:", chosen.Name)

    for attempt = 1, 3 do
        ClickGui(chosen, "skill " .. chosen.Name .. " #" .. attempt)
        local resolved = WaitFor(function()
            return IsFrameVisible(AttacksPage.Enemies)
                or not IsFrameVisible(AttackScroll)
        end, 1.5, "skill click resolves")
        if resolved then break end
        if attempt == 3 then return end
    end

    -- Step 3: pick an enemy if list opened
    if IsFrameVisible(AttacksPage.Enemies) and not IsFrameVisible(AttackScroll) then
        task.wait(0.2)
        local target = FindFirstEnemy(combat)
        if not target then return end

        for attempt = 1, 3 do
            ClickGui(target, "enemy " .. target.Name .. " #" .. attempt)
            if WaitFor(function()
                return not IsFrameVisible(AttacksPage.Enemies)
                    or IsFrameVisible(ContextPage)
            end, 1.5, "enemy click resolves") then
                print("[AutoSkill] Done.")
                return
            end
        end
    end
end

----------------------------------------------------- AutoSkill watcher

local AutoRunning = false
local LastActionVisible = false
local FirstFire = true

task.spawn(function()
    while true do
        if AutoSkillEnabled then
            local pg = LocalPlayer:FindFirstChild("PlayerGui")
            local combat = pg and pg:FindFirstChild("Combat")
            local ActionBG = combat and combat:FindFirstChild("ActionBG")

            if ActionBG then
                local ContextPage = ActionBG:FindFirstChild("ContextPage")
                local AttacksPage = ActionBG:FindFirstChild("AttacksPage")

                local actionVisible = IsFrameVisible(ActionBG)
                local atContextHome = ContextPage and IsFrameVisible(ContextPage)
                                  and AttacksPage and not IsFrameVisible(AttacksPage)

                if LastActionVisible and not actionVisible then
                    FirstFire = true
                end

                local risingEdge = actionVisible and not LastActionVisible
                local shouldFire = (risingEdge or FirstFire)
                                and actionVisible and atContextHome
                                and not AutoRunning
                                and InCombat
                if shouldFire then
                    AutoRunning = true
                    task.spawn(function()
                        local settleTime = FirstFire and 1.0 or 0.4
                        task.wait(settleTime)

                        local pg2 = LocalPlayer:FindFirstChild("PlayerGui")
                        local c2 = pg2 and pg2:FindFirstChild("Combat")
                        local AB2 = c2 and c2:FindFirstChild("ActionBG")
                        local CP2 = AB2 and AB2:FindFirstChild("ContextPage")
                        if AB2 and CP2 and IsFrameVisible(AB2) and IsFrameVisible(CP2) then
                            local ok, err = pcall(AutoSkill, c2)
                            if not ok then warn("[AutoSkill] error: " .. tostring(err)) end
                            FirstFire = false
                        end
                        task.wait(1.2)
                        AutoRunning = false
                    end)
                end

                LastActionVisible = actionVisible
            else
                LastActionVisible = false
                FirstFire = true
            end
        end
        task.wait(0.1)
    end
end)

----------------------------------------------------- In-combat detection

local function GetCombatStatus()
    local ok, result = pcall(function()
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if not pg then return false end
        local hud = pg:FindFirstChild("HUD")
        if not hud then return false end
        local holder = hud:FindFirstChild("Holder")
        if not holder then return false end
        local cn = holder:FindFirstChild("CharacterName")
        if not cn then return false end
        local plrName = cn:FindFirstChild("PlrName")
        if not plrName then return false end

        local TextColor = GetTextColor(plrName)
        local inCombatColor = Color3.new(1, 0.65, 0.65)
        return ColorsMatch(TextColor, inCombatColor)
    end)
    return ok and result or false
end

local CombatThread = nil

print("[ARCANE LINEAGE] Thread started")

task.spawn(function()
    while true do
        local CurrentlyInCombat = GetCombatStatus()

        if CurrentlyInCombat and not InCombat then
            InCombat = true
            send_notification("[ArcaneStuff] Combat Started", "info")
            print("[ARCANE LINEAGE] In combat")

            if not CombatThread then
                CombatThread = task.spawn(CombatLoop)
            end

        elseif not CurrentlyInCombat and InCombat then
            InCombat = false
            send_notification("[ArcaneStuff] Out of Combat", "info")
            print("[ARCANE LINEAGE] Out of combat")
            if CombatThread then
                task.cancel(CombatThread)
                CombatThread = nil
            end
        end

        task.wait(0.5)
    end
end)
