----------------------------------------------------- Memory reading
-- Severe lets us pass (userdata, offset) directly, so we don't need
-- Instance.Address. The offsets are the same as Matcha's.

local function IsScreenGuiEnabled(ScreenGui)
    if not ScreenGui then return end
    local Status = memory.readu8(ScreenGui, Offsets.ScreenGuiEnabled)
    return Status ~= 0
end

local function IsFrameVisible(Frame)
    if not Frame then return false end
    local ok, val = pcall(memory.readu8, Frame, Offsets.FrameVisible)
    if not ok then return false end
    return val ~= 0
end

local function GetTextColor(TextLabel)
    if not TextLabel then return nil end
    local TextColorOffset = 0xE70

    local ok, r, g, b = pcall(function()
        return memory.readf32(TextLabel, TextColorOffset),
               memory.readf32(TextLabel, TextColorOffset + 4),
               memory.readf32(TextLabel, TextColorOffset + 8)
    end)

    if ok and r and g and b then
        return Color3.new(r, g, b)
    end
    return nil
end

local function GetName(InstanceObj)
    -- Read the Name pointer at Offsets.Name, then read the null-terminated
    -- string at that pointer. memory.readstring takes either an absolute
    -- address or (userdata, offset).
    if not InstanceObj then return end
    local namePointer = memory.readu64(InstanceObj, Offsets.Name)
    if namePointer == 0 then return nil end
    return memory.readstring(namePointer)
end

local function BruteForceImageId(ImageObject)
    if not ImageObject then return nil end
    print("--- Brute Forcing Offsets for: " .. ImageObject.Name .. " ---")

    for offset = 0, 4096, 4 do
        local success, ptr = pcall(memory.readu64, ImageObject, offset)
        if success and ptr and ptr > 0x1000 then
            local strSuccess, value = pcall(memory.readstring, ptr)
            if strSuccess and value and #value > 5 then
                if string.find(value, "rbxassetid://") or string.find(value, "asset") then
                    print(string.format("[!] FOUND ID at Offset 0x%X: %s", offset, value))
                    return value, offset
                end
            end
        end
    end

    print("--- Scan Complete: No ID found ---")
    return nil
end

local function GetImageId(ImageObject)
    if not ImageObject then return nil end
    local ImageButtonOffset = 0xCC8 -- needs to be manually tracked

    local function read(off)
        local ptr = memory.readu64(ImageObject, off)
        if ptr == 0 then return nil end
        local ok, str = pcall(memory.readstring, ptr)
        return ok and str or nil
    end

    return read(ImageButtonOffset) or read(TheoOffsets.GuiObject.Image)
end

local function GetBackgroundColor(ImageObject)
    if not ImageObject then return nil end
    local BGcolorOffset = TheoOffsets.GuiObject.BackgroundColor3

    local ok, r, g, b = pcall(function()
        return memory.readf32(ImageObject, BGcolorOffset),
               memory.readf32(ImageObject, BGcolorOffset + 4),
               memory.readf32(ImageObject, BGcolorOffset + 8)
    end)

    if ok and r and g and b then
        return Color3.new(r, g, b)
    end
    return nil
end

local function GetImageColor(ImageObject)
    if not ImageObject then return nil end
    local Offset = (ImageObject.ClassName == "ImageButton") and 0xD38 or 0xB58

    local ok, r, g, b = pcall(function()
        return memory.readf32(ImageObject, Offset),
               memory.readf32(ImageObject, Offset + 4),
               memory.readf32(ImageObject, Offset + 8)
    end)

    if ok and r and g and b then
        return Color3.new(r, g, b)
    end
    return nil
end

local function BruteForceTransparency(ImageObject, TargetValue)
    if not ImageObject then return nil end
    local Epsilon = 0.001
    TargetValue = tonumber(TargetValue) or 0

    print(string.format("--- Brute Forcing Transparency (%.2f) for: %s ---", TargetValue, ImageObject.Name))

    for offset = 0, 4096, 4 do
        local success, value = pcall(memory.readf32, ImageObject, offset)
        if success and value and math.abs(value - TargetValue) < Epsilon then
            if value >= 0 and value <= 1 then
                print(string.format("[!] POTENTIAL Transparency at Offset 0x%X: %.4f", offset, value))
                return value, offset
            end
        end
    end

    print("--- Scan Complete: No matching transparency found ---")
    return nil
end

local function GetImageTransparency(GuiObject)
    if not GuiObject then return nil end
    local TransparencyOffset = 0xA7C
    return memory.readf32(GuiObject, TransparencyOffset)
end

local function GetFrameRotation(ImageObject)
    if not ImageObject then return nil end
    return memory.readf32(ImageObject, Offsets.FrameRotation)
end

local LastValues = {}

local function ScanForChangedRotation(ImageObject)
    if not ImageObject then return end

    for offset = 0, 4096, 4 do
        local success, value = pcall(memory.readf32, ImageObject, offset)
        if success and value then
            if LastValues[offset] and math.abs(value - LastValues[offset]) > 0.01 then
                if value >= -360 and value <= 360 then
                    print(string.format("[!] VALUE CHANGED | Offset: 0x%X | Old: %.2f | New: %.2f",
                        offset, LastValues[offset], value))
                end
            end
            LastValues[offset] = value
        end
    end
end

local function SAFEWriteFrameRotation(ImageObject, NewRotation)
    if not ImageObject then return false end
    local LogicOffset = 0x5A0
    memory.writef32(ImageObject, LogicOffset, NewRotation)
    return true
end

-- Severe doesn't expose RunService.Heartbeat, so use a spawned task.wait loop.
local function LockRotationForDuration(Ring, TargetRotation, Duration)
    task.spawn(function()
        local StartTick = os.clock()
        while (os.clock() - StartTick) < Duration do
            SAFEWriteFrameRotation(Ring, TargetRotation)
            task.wait()
        end
    end)
end

----------------------------------------------------- Helpers

-- AbsolutePosition / AbsoluteSize are not exposed as direct properties on
-- Severe's GUI objects. Read them from memory using the offsets feed.
-- We resolve the offsets once at startup; if a key is missing from the feed
-- we fall back to commonly-seen offsets and log what we found.
local function resolveOffset(possiblePaths, fallback)
    for _, path in ipairs(possiblePaths) do
        local cur = TheoOffsets
        for part in path:gmatch("[^%.]+") do
            if type(cur) ~= "table" then cur = nil break end
            cur = cur[part]
        end
        if type(cur) == "number" then
            return cur, path
        end
    end
    return fallback, "fallback"
end

-- These keys live under `GuiBase2D` in the Theo offsets dump, not `GuiObject`.
-- Note the capital D — `GuiBase2d` (lowercase d) won't match.
local AbsolutePositionOffset, _apSrc = resolveOffset({
    "GuiBase2D.AbsolutePosition",
    "GuiObject.AbsolutePosition",
}, 272) -- 0x110, value from imtheo.lol dump (older build, but close)
local AbsoluteSizeOffset, _asSrc = resolveOffset({
    "GuiBase2D.AbsoluteSize",
    "GuiObject.AbsoluteSize",
}, 280) -- 0x118, value from imtheo.lol dump

print(string.format("[Offsets] AbsolutePosition = 0x%X (%s)", AbsolutePositionOffset, _apSrc))
print(string.format("[Offsets] AbsoluteSize     = 0x%X (%s)", AbsoluteSizeOffset, _asSrc))

-- Helpful one-time dump so you can see what keys are actually in the feed
-- if the resolver had to fall back.
if _apSrc == "fallback" or _asSrc == "fallback" then
    print("[Offsets] Available keys in TheoOffsets:")
    for _, section in ipairs({ "GuiBase2D", "GuiObject" }) do
        local tbl = TheoOffsets[section]
        print(string.format("  %s = %s", section, type(tbl)))
        if type(tbl) == "table" then
            for k, v in pairs(tbl) do
                print(string.format("    %s = %s", tostring(k), tostring(v)))
            end
        end
    end
end

-- Drift canary: ScreenGui's AbsoluteSize should match Camera.ViewportSize.
-- If they don't, our offsets are wrong for this Roblox build — warn loudly
-- so you know to grab fresh offsets instead of silently misbehaving.
do
    local ok, msg = pcall(function()
        local vp = workspace.CurrentCamera.ViewportSize
        local sx = memory.readf32(CombatScreenGui, AbsoluteSizeOffset)
        local sy = memory.readf32(CombatScreenGui, AbsoluteSizeOffset + 4)
        local dx = math.abs(sx - vp.X)
        local dy = math.abs(sy - vp.Y)
        if dx > 8 or dy > 8 then
            error(string.format(
                "ScreenGui AbsoluteSize (%.0f, %.0f) doesn't match viewport (%.0f, %.0f)",
                sx, sy, vp.X, vp.Y))
        end
        print(string.format("[Sanity] OK — ScreenGui.AbsoluteSize (%.0f, %.0f) ≈ ViewportSize",
            sx, sy))
    end)
    if not ok then
        warn("[Sanity] OFFSETS MAY BE WRONG: " .. tostring(msg))
        warn("[Sanity] Grab fresh offsets from https://imtheo.lol/Offsets/")
        warn("[Sanity] (find your Roblox version folder at %LocalAppData%\\Roblox\\Versions)")
    end
end

local function GetAbsolutePosition(GuiObject)
    if not GuiObject then return Vector2.new(0, 0) end
    local x = memory.readf32(GuiObject, AbsolutePositionOffset)
    local y = memory.readf32(GuiObject, AbsolutePositionOffset + 4)
    return Vector2.new(x, y)
end

local function GetAbsoluteSize(GuiObject)
    if not GuiObject then return Vector2.new(0, 0) end
    local x = memory.readf32(GuiObject, AbsoluteSizeOffset)
    local y = memory.readf32(GuiObject, AbsoluteSizeOffset + 4)
    return Vector2.new(x, y)
end

local function ColorsMatch(Color3_A, Color3_B)
    local Tolerance = 0.1
    if not Color3_A or not Color3_B then return false end

    local rDiff = math.abs(Color3_A.R - Color3_B.R)
    local gDiff = math.abs(Color3_A.G - Color3_B.G)
    local bDiff = math.abs(Color3_A.B - Color3_B.B)

    return (rDiff <= Tolerance and gDiff <= Tolerance and bDiff <= Tolerance)
end

local function AreUIObjectsAligned(ObjectA, ObjectB)
    local posA, sizeA = GetAbsolutePosition(ObjectA), GetAbsoluteSize(ObjectA)
    local posB, sizeB = GetAbsolutePosition(ObjectB), GetAbsoluteSize(ObjectB)

    local centerAX = posA.X + (sizeA.X / 2)
    local centerAY = posA.Y + (sizeA.Y / 2)
    local centerBX = posB.X + (sizeB.X / 2)
    local centerBY = posB.Y + (sizeB.Y / 2)

    local diffX = centerAX - centerBX
    local diffY = centerAY - centerBY
    local Distance = math.sqrt(diffX^2 + diffY^2)

    local isAligned = (math.abs(diffX) < (sizeA.X + sizeB.X) / 2)
                  and (math.abs(diffY) < (sizeA.Y + sizeB.Y) / 2)

    return isAligned, Distance
end

local Dragging = false

-- Severe Drawing.new("Text") props differ slightly from Matcha:
--   - Font is a NUMBER index (0..31), not a string
--   - Has Opacity in [0,1]
local function _DragDebug()
    local DragText = Drawing.new("Text")
    DragText.Visible = true
    DragText.Center = true
    DragText.Outline = true
    DragText.Size = 20
    DragText.Color = Color3.fromRGB(255, 255, 255)
    DragText.Opacity = 1

    while Dragging do
        local MousePosition = UserInputService:GetMouseLocation()
        local IsPressed = isleftpressed()
        DragText.Text = string.format("Dragging Active | M1: %s",
            IsPressed and "PRESSED" or "RELEASED")
        DragText.Color = IsPressed
            and Color3.fromRGB(0, 255, 0)
            or  Color3.fromRGB(255, 255, 255)
        DragText.Position = MousePosition + Vector2.new(0, 30)
        task.wait(0.01)
    end

    DragText:Remove()
end

local MAX_X, MAX_Y = 1920, 1080

local function IsValid(Pos)
    return Pos
        and (Pos.X == Pos.X) -- NaN check
        and Pos.X > 0 and Pos.X < MAX_X
        and Pos.Y > 0 and Pos.Y < MAX_Y
end

local function ApplyVariance(Pos, Amount)
    if not Amount or Amount <= 0 then return Pos end
    local offsetX = math.random(-Amount, Amount)
    local offsetY = math.random(-Amount, Amount)
    return Vector2.new(Pos.X + offsetX, Pos.Y + offsetY)
end

local function ClickAndDragTo(StartPosition, NewPosition, Duration, Variance)
    local ActualStart = ApplyVariance(StartPosition, Variance)
    local ActualEnd = ApplyVariance(NewPosition, Variance)

    if not IsValid(ActualStart) or not IsValid(ActualEnd) then return end

    Dragging = true
    task.spawn(_DragDebug)

    mousemoveabs(ActualStart.X, ActualStart.Y)
    task.wait(0.01)
    mousemoverel(math.random(1, 5), math.random(1, 5))

    mouse1press()
    task.wait(0.05)

    if not Duration or Duration <= 0 then
        mousemoveabs(ActualEnd.X, ActualEnd.Y)
    else
        local TotalDelta = ActualEnd - ActualStart
        local StartTime = os.clock()
        while os.clock() - StartTime < Duration do
            local Elapsed = os.clock() - StartTime
            local Progress = math.clamp(Elapsed / Duration, 0, 1)
            local TargetPos = ActualStart + (TotalDelta * Progress)
            mousemoveabs(TargetPos.X, TargetPos.Y)
            task.wait()
        end
    end

    task.wait(0.05)
    mouse1release()
    Dragging = false
end

local function GetCenter(GuiObject)
    local Pos = GetAbsolutePosition(GuiObject)
    local Size = GetAbsoluteSize(GuiObject)
    return Vector2.new(Pos.X + (Size.X / 2), Pos.Y + (Size.Y / 2))
end

